---
interface Props {
  calabazaSrc?: string;
  caritas?: Array<{
    id: string;
    nombre: string;
    expresion: string;
    src: string;
  }>;
  nombre?: string;
  alto?: string;
  mostrarSelector?: boolean;
}

const {
  calabazaSrc = "/models/calaba/calabaza.glb",
  caritas = [
    { id: "pum1", nombre: "Pícaro", expresion: "o.<", src: "/models/calaba/cat-pum1.glb" },
    { id: "pum2", nombre: "Travieso", expresion: ">.<", src: "/models/calaba/cat-pum2.glb" },
    { id: "pum3", nombre: "Curioso", expresion: "o.o", src: "/models/calaba/cat-pum3.glb" },
  ],
  nombre = "Mishi Calabaza",
  alto = "h-[420px] md:h-[540px]",
  mostrarSelector = true,
} = Astro.props;
---

<div
  data-pumpkin-clicker
  data-calabaza={calabazaSrc}
  data-caritas={JSON.stringify(caritas)}
  class:list={["group relative w-full overflow-hidden rounded-[28px] border border-[#3b2a1e]/10 bg-gradient-to-b from-[#f7e9cf] to-[#e9c896] select-none", alto]}
>
  <canvas class="block h-full w-full touch-none cursor-grab active:cursor-grabbing" aria-label={"Clicker 3D de " + nombre + " con 3 caritas intercambiables. Clickea para jugar."}></canvas>

  <!-- halo -->
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_55%_at_50%_38%,rgba(255,92,138,0.22),transparent_70%),radial-gradient(50%_40%_at_70%_80%,rgba(124,92,255,0.25),transparent_70%)]"></div>

  <!-- Marcador de caricias -->
  <div class="absolute top-3 right-3 left-3 z-20 flex items-center justify-between gap-2 pointer-events-none">
    <div class="flex items-center gap-2 rounded-full border border-black/10 bg-white/80 px-3 py-1.5 shadow-sm backdrop-blur-md sm:px-4 sm:py-2">
      <span class="text-base sm:text-lg">🐾</span>
      <span class="font-display text-base font-semibold text-[#b45309] sm:text-lg" data-count>0</span>
      <span class="hidden text-xs font-extrabold tracking-widest text-[#3b2a1e]/60 min-[420px]:inline">CARICIAS</span>
    </div>

    <div class="flex items-center gap-1.5 rounded-full border border-black/10 bg-white/80 px-3 py-1 text-[11px] font-bold text-[#3b2a1e]/75 shadow-sm backdrop-blur-md">
      <span class="inline-block h-2 w-2 rounded-full bg-[#ff5c8a]"></span>
      <span class="hidden sm:inline">3 caritas 3D</span>
      <span class="sm:hidden">3D</span>
    </div>
  </div>

  <!-- Selector de 3 Caritas de Gato -->
  {mostrarSelector && (
    <div class="absolute bottom-3 left-3 z-20 flex flex-col gap-1.5">
      <span class="text-[10px] font-extrabold tracking-wider text-[#3b2a1e]/70 uppercase px-1">
        Cambiar carita:
      </span>
      <div class="flex items-center gap-1.5 rounded-2xl border border-[#3b2a1e]/10 bg-white/85 p-1 backdrop-blur-md shadow-sm">
        {caritas.map((c, i) => (
          <button
            type="button"
            data-face-btn={c.id}
            data-face-idx={i}
            class:list={[
              "relative flex items-center gap-1.5 rounded-xl px-2.5 py-1.5 text-xs font-extrabold transition-all cursor-pointer",
              i === 0
                ? "bg-[#ff5c8a] text-white shadow-sm scale-105"
                : "text-[#3b2a1e]/75 hover:bg-[#f6ecdd] hover:text-[#3b2a1e]"
            ]}
          >
            <span class="font-mono text-xs">{c.expresion}</span>
            <span class="text-[11px] hidden sm:inline">{c.nombre}</span>
          </button>
        ))}
      </div>
    </div>
  )}

  <!-- Botón de acariciar -->
  <div class="absolute right-3 bottom-3 z-20">
    <button
      type="button"
      data-btn-acariciar
      class="group/btn flex items-center gap-2 rounded-full bg-[#3b2a1e] px-5 py-2 text-xs font-extrabold text-[#fff8ee] shadow-[0_8px_24px_rgba(59,42,30,.35)] transition hover:brightness-125 active:scale-95 cursor-pointer"
    >
      <span>¡Acariciar!</span>
      <span class="text-base group-hover/btn:rotate-12 transition-transform">💛</span>
    </button>
  </div>

  <!-- Estado de carga -->
  <div data-carga class="absolute inset-0 z-30 flex flex-col items-center justify-center gap-4 bg-[#f3e2c7]/90 backdrop-blur-sm transition-opacity duration-500">
    <div class="relative">
      <svg width="88" height="88" viewBox="0 0 88 88" class="animate-[giro_2.4s_linear_infinite]">
        <circle cx="44" cy="44" r="36" fill="none" stroke="rgba(59,42,30,.15)" stroke-width="7" />
        <path d="M44 8 a36 36 0 0 1 31 18" fill="none" stroke="#ff5c8a" stroke-width="7" stroke-linecap="round" />
      </svg>
      <div class="absolute inset-0 grid place-items-center text-3xl">🐱</div>
    </div>
    <p class="font-display text-lg text-[#3b2a1e]" data-carga-txt>Preparando al michi…</p>
    <p class="text-sm text-[#3b2a1e]/60">amasando polígonos y ronroneos</p>
  </div>

  <!-- Estado de error -->
  <div data-error class="absolute inset-0 z-30 hidden flex-col items-center justify-center gap-3 bg-[#f3e2c7] p-8 text-center">
    <div class="text-5xl">😿</div>
    <p class="font-display text-xl text-[#3b2a1e]">El michi no quiso salir</p>
    <p class="max-w-xs text-sm text-[#3b2a1e]/60">No pudimos cargar los modelos 3D. Revisa tu conexión e inténtalo de nuevo.</p>
  </div>
</div>

<script type="module">
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function easeInQuad(x) { return x * x; }

  function emojiTexture(emoji) {
    const c = document.createElement("canvas");
    c.width = c.height = 128;
    const ctx = c.getContext("2d");
    ctx.font = "88px serif";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(emoji, 64, 68);
    const tex = new THREE.CanvasTexture(c);
    tex.colorSpace = THREE.SRGBColorSpace;
    return tex;
  }

  document.querySelectorAll("[data-pumpkin-clicker]").forEach((root) => {
    const canvas = root.querySelector("canvas");
    const capaCarga = root.querySelector("[data-carga]");
    const txtCarga = root.querySelector("[data-carga-txt]");
    const capaError = root.querySelector("[data-error]");
    const elCount = root.querySelector("[data-count]");
    const btnAcariciar = root.querySelector("[data-btn-acariciar]");
    const faceButtons = root.querySelectorAll("[data-face-btn]");

    const calabazaSrc = root.getAttribute("data-calabaza") || "/models/calaba/calabaza.glb";
    let caritasConfig = [];
    try {
      caritasConfig = JSON.parse(root.getAttribute("data-caritas") || "[]");
    } catch {
      caritasConfig = [
        { id: "pum1", src: "/models/calaba/cat-pum1.glb" },
        { id: "pum2", src: "/models/calaba/cat-pum2.glb" },
        { id: "pum3", src: "/models/calaba/cat-pum3.glb" }
      ];
    }

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.25;
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;

    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0xf0d9b4, 0.04);

    const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 60);
    const CAM_HOME = new THREE.Vector3(0.5, 2.3, 5.8);
    const TARGET_HOME = new THREE.Vector3(0, 1.1, 0);
    camera.position.copy(CAM_HOME);

    const controls = new OrbitControls(camera, canvas);
    controls.target.copy(TARGET_HOME);
    controls.enableDamping = true;
    controls.dampingFactor = 0.06;
    controls.minDistance = 2.4;
    controls.maxDistance = 8.5;
    controls.maxPolarAngle = Math.PI * 0.52;
    controls.minPolarAngle = Math.PI * 0.12;
    controls.enablePan = false;
    controls.autoRotate = !reduceMotion;
    controls.autoRotateSpeed = 1.3;

    // --- Luces de estudio cálido ---
    scene.add(new THREE.HemisphereLight(0xfff6e9, 0x8a6f4d, 1.1));

    const key = new THREE.DirectionalLight(0xffe9c4, 2.4);
    key.position.set(3.5, 6, 4.5);
    key.castShadow = true;
    key.shadow.mapSize.set(1024, 1024);
    scene.add(key);

    const velaPoint = new THREE.PointLight(0xffb84d, 10, 12);
    velaPoint.position.set(0, 1.2, 2.8);
    scene.add(velaPoint);

    const rimPurpura = new THREE.PointLight(0xff5c8a, 24, 22);
    rimPurpura.position.set(-3.5, 3.2, -2.8);
    scene.add(rimPurpura);

    const fillVerde = new THREE.PointLight(0x7c5cff, 18, 20);
    fillVerde.position.set(3.5, 2.2, -3);
    scene.add(fillVerde);

    // --- Alfombra cálida ---
    const alfombra = new THREE.Mesh(
      new THREE.CircleGeometry(2.3, 64),
      new THREE.MeshStandardMaterial({
        color: 0xc99e67,
        roughness: 0.95,
        metalness: 0
      })
    );
    alfombra.rotation.x = -Math.PI / 2;
    alfombra.receiveShadow = true;
    scene.add(alfombra);

    const aroNaranja = new THREE.Mesh(
      new THREE.RingGeometry(2.28, 2.4, 64),
      new THREE.MeshBasicMaterial({
        color: 0xffb84d,
        transparent: true,
        opacity: 0.65,
        side: THREE.DoubleSide
      })
    );
    aroNaranja.rotation.x = -Math.PI / 2;
    aroNaranja.position.y = 0.01;
    scene.add(aroNaranja);

    const aroPurpura = new THREE.Mesh(
      new THREE.RingGeometry(1.85, 1.92, 64),
      new THREE.MeshBasicMaterial({
        color: 0xff5c8a,
        transparent: true,
        opacity: 0.35,
        side: THREE.DoubleSide
      })
    );
    aroPurpura.rotation.x = -Math.PI / 2;
    aroPurpura.position.y = 0.012;
    scene.add(aroPurpura);

    // --- Partículas de festejo ---
    const FESTEJO_N = 30;
    const festejo = [];
    const texturas = [
      emojiTexture("💗"),
      emojiTexture("🐾"),
      emojiTexture("✨"),
      emojiTexture("🐱")
    ];
    for (let i = 0; i < FESTEJO_N; i++) {
      const mat = new THREE.SpriteMaterial({
        map: texturas[i % texturas.length],
        transparent: true,
        opacity: 0,
        depthWrite: false
      });
      const s = new THREE.Sprite(mat);
      s.scale.setScalar(0.3 + Math.random() * 0.22);
      s.visible = false;
      scene.add(s);
      festejo.push({ s, vel: new THREE.Vector3(), vida: 0 });
    }

    function lanzarFestejo(origen) {
      let lanzadas = 0;
      for (const p of festejo) {
        if (p.vida > 0) continue;
        p.vida = 1.0 + Math.random() * 0.6;
        p.s.visible = true;
        p.s.position.copy(origen).add(
          new THREE.Vector3((Math.random() - 0.5) * 0.7, Math.random() * 0.35, (Math.random() - 0.5) * 0.7)
        );
        p.vel.set((Math.random() - 0.5) * 3.4, 3.4 + Math.random() * 2.4, (Math.random() - 0.5) * 3.4);
        if (++lanzadas >= 16) break;
      }
    }

    // --- Sonido de teclado mecánico (click-clack nítido y con buen volumen) ---
    let audioCtx = null;
    function popHalloween() {
      try {
        audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === "suspended") audioCtx.resume();
        const t = audioCtx.currentTime;

        const master = audioCtx.createDynamicsCompressor();
        master.threshold.setValueAtTime(-12, t);
        master.ratio.setValueAtTime(4, t);
        const masterGain = audioCtx.createGain();
        masterGain.gain.setValueAtTime(1.35, t);
        master.connect(masterGain).connect(audioCtx.destination);

        function teclaMecanica(at, clickFreq, thockStart, thockEnd, vol) {
          const len = Math.floor(audioCtx.sampleRate * 0.014);
          const buf = audioCtx.createBuffer(1, len, audioCtx.sampleRate);
          const data = buf.getChannelData(0);
          for (let i = 0; i < len; i++) {
            data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (len * 0.16));
          }
          const noise = audioCtx.createBufferSource();
          noise.buffer = buf;

          const hp = audioCtx.createBiquadFilter();
          hp.type = "highpass";
          hp.frequency.setValueAtTime(1600, at);

          const bp = audioCtx.createBiquadFilter();
          bp.type = "bandpass";
          bp.frequency.setValueAtTime(clickFreq, at);
          bp.Q.setValueAtTime(2.2, at);

          const ng = audioCtx.createGain();
          ng.gain.setValueAtTime(vol * 1.15, at);
          ng.gain.exponentialRampToValueAtTime(0.001, at + 0.013);

          noise.connect(hp).connect(bp).connect(ng).connect(master);
          noise.start(at);

          const osc = audioCtx.createOscillator();
          const og = audioCtx.createGain();
          osc.type = "triangle";
          osc.frequency.setValueAtTime(thockStart, at);
          osc.frequency.exponentialRampToValueAtTime(thockEnd, at + 0.024);
          og.gain.setValueAtTime(vol * 0.85, at);
          og.gain.exponentialRampToValueAtTime(0.001, at + 0.028);
          osc.connect(og).connect(master);
          osc.start(at);
          osc.stop(at + 0.03);

          const body = audioCtx.createOscillator();
          const bg = audioCtx.createGain();
          body.type = "sine";
          body.frequency.setValueAtTime(155, at);
          body.frequency.exponentialRampToValueAtTime(65, at + 0.022);
          bg.gain.setValueAtTime(vol * 0.55, at);
          bg.gain.exponentialRampToValueAtTime(0.001, at + 0.025);
          body.connect(bg).connect(master);
          body.start(at);
          body.stop(at + 0.028);
        }

        const jitter = (Math.random() - 0.5) * 240;
        teclaMecanica(t, 3900 + jitter, 340, 95, 0.85);
        teclaMecanica(t + 0.115, 4700 + jitter, 420, 130, 0.58);
      } catch (e) { /* silencioso */ }
    }

    // --- Modelos ---
    const loader = new GLTFLoader();
    let calabazaScene = null;
    let calabazaScale = 1;
    let calabazaHeight = 1.8;

    const catScenes = []; // [ { id, scene, basePos, baseY } ]
    let activeFaceIndex = 0;
    let clickerReady = false;
    let caricias = 0;

    let pressT = -1;
    const PRESS_DUR = 0.52;
    const PRESS_DEPTH = 0.36; // Profundidad con la que el gato se sumerge en la calabaza

    function setupCalabaza(gltf) {
      calabazaScene = gltf.scene;
      const box = new THREE.Box3().setFromObject(calabazaScene);
      const center = box.getCenter(new THREE.Vector3());
      const size = box.getSize(new THREE.Vector3());

      const maxDim = Math.max(size.x, size.z);
      calabazaScale = 2.85 / maxDim; // Escalar a ~2.85 unidades de ancho

      calabazaScene.scale.setScalar(calabazaScale);
      calabazaScene.position.x = -center.x * calabazaScale;
      calabazaScene.position.z = -center.z * calabazaScale;
      calabazaScene.position.y = -box.min.y * calabazaScale;

      calabazaHeight = size.y * calabazaScale;

      calabazaScene.traverse((o) => {
        if (o.isMesh) {
          o.castShadow = true;
          o.receiveShadow = true;
          if (o.material) {
            o.material.roughness = 0.5;
          }
        }
      });

      scene.add(calabazaScene);
    }

    function setupCatFace(gltf, config, index) {
      const sceneGato = gltf.scene;
      const box = new THREE.Box3().setFromObject(sceneGato);
      const center = box.getCenter(new THREE.Vector3());
      const size = box.getSize(new THREE.Vector3());

      // Usar la misma escala que la calabaza para mantener proporciones mecánicas
      sceneGato.scale.setScalar(calabazaScale);
      sceneGato.position.x = -center.x * calabazaScale;
      // Centrado exacto en la apertura de la calabaza
      sceneGato.position.z = -center.z * calabazaScale - 0.11;

      // El gato se asoma saliendo de la apertura superior de la calabaza
      const baseY = -box.min.y * calabazaScale + calabazaHeight * 0.46;
      sceneGato.position.y = baseY;

      sceneGato.traverse((o) => {
        if (o.isMesh) {
          o.castShadow = true;
          o.receiveShadow = false;
          if (o.material) {
            o.material.roughness = 0.45;
          }
        }
      });

      sceneGato.visible = (index === activeFaceIndex);
      scene.add(sceneGato);

      catScenes[index] = {
        id: config.id,
        scene: sceneGato,
        baseY: baseY,
        sizeY: size.y * calabazaScale
      };
    }

    function checkReady() {
      if (!calabazaScene) return;
      if (!catScenes[0]) return; // Al menos la primera carita lista

      clickerReady = true;
      if (capaCarga) {
        capaCarga.style.opacity = "0";
        setTimeout(() => capaCarga.remove(), 550);
      }
    }

    // 1. Cargar Calabaza
    loader.load(
      calabazaSrc,
      (gltf) => {
        setupCalabaza(gltf);

        // 2. Una vez que la calabaza tiene su escala, cargar las caritas de gato
        caritasConfig.forEach((cfg, idx) => {
          loader.load(
            cfg.src,
            (catGltf) => {
              setupCatFace(catGltf, cfg, idx);
              checkReady();
            },
            (ev) => {
              if (ev.total && txtCarga && idx === 0) {
                const pct = Math.round((ev.loaded / ev.total) * 100);
                txtCarga.textContent = `Invocando al michi… ${pct}%`;
              }
            },
            (err) => {
              console.error("Error cargando carita " + cfg.src, err);
            }
          );
        });
      },
      (ev) => {
        if (ev.total && txtCarga) {
          const pct = Math.round((ev.loaded / ev.total) * 100);
          txtCarga.textContent = `Tallando la calabaza… ${pct}%`;
        }
      },
      (err) => {
        console.error("Error cargando calabaza", err);
        if (capaCarga) capaCarga.remove();
        if (capaError) capaError.style.display = "flex";
      }
    );

    // --- Cambiar carita activa ---
    function cambiarCarita(index) {
      if (index === activeFaceIndex) return;
      activeFaceIndex = index;

      catScenes.forEach((item, idx) => {
        if (item && item.scene) {
          item.scene.visible = (idx === activeFaceIndex);
          if (idx === activeFaceIndex) {
            item.scene.position.y = item.baseY;
          }
        }
      });

      // Actualizar estilo de botones
      faceButtons.forEach((btn, idx) => {
        if (idx === activeFaceIndex) {
          btn.className = "relative flex items-center gap-1.5 rounded-xl px-2.5 py-1.5 text-xs font-extrabold transition-all cursor-pointer bg-[#ff5c8a] text-white shadow-sm scale-105";
        } else {
          btn.className = "relative flex items-center gap-1.5 rounded-xl px-2.5 py-1.5 text-xs font-extrabold transition-all cursor-pointer text-[#3b2a1e]/75 hover:bg-[#f6ecdd] hover:text-[#3b2a1e]";
        }
      });

      if (!reduceMotion) popHalloween();
    }

    faceButtons.forEach((btn, idx) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        cambiarCarita(idx);
      });
    });

    // --- Clicker / Acariciar ---
    const rayo = new THREE.Raycaster();
    const puntero = new THREE.Vector2();
    let downX = 0, downY = 0;

    function ndcDeEvento(e) {
      const r = canvas.getBoundingClientRect();
      const cx = (e.clientX !== undefined) ? e.clientX : (e.touches && e.touches[0].clientX);
      const cy = (e.clientY !== undefined) ? e.clientY : (e.touches && e.touches[0].clientY);
      return {
        x: ((cx - r.left) / r.width) * 2 - 1,
        y: -((cy - r.top) / r.height) * 2 + 1,
      };
    }

    function golpeaModelo(e) {
      const activeCat = catScenes[activeFaceIndex];
      const p = ndcDeEvento(e);
      puntero.set(p.x, p.y);
      rayo.setFromCamera(puntero, camera);

      // Si golpea al gato o la calabaza
      if (activeCat && activeCat.scene) {
        if (rayo.intersectObject(activeCat.scene, true).length > 0) return true;
      }
      if (calabazaScene) {
        if (rayo.intersectObject(calabazaScene, true).length > 0) return true;
      }
      return false;
    }

    canvas.addEventListener("pointerdown", (e) => {
      downX = e.clientX;
      downY = e.clientY;
    });

    canvas.addEventListener("pointerup", (e) => {
      const mov = Math.hypot(e.clientX - downX, e.clientY - downY);
      if (mov > 7) return; // Arrastro cámara
      if (golpeaModelo(e)) {
        acariciar();
      }
    });

    function acariciar() {
      if (!clickerReady) return;
      if (pressT >= 0 && pressT < 0.4) return;

      pressT = 0;
      caricias++;

      if (elCount) {
        elCount.textContent = caricias;
        elCount.parentElement.animate(
          [
            { transform: "scale(1)", filter: "brightness(1)" },
            { transform: "scale(1.28)", filter: "brightness(1.4)" },
            { transform: "scale(1)", filter: "brightness(1)" }
          ],
          { duration: 320, easing: "cubic-bezier(0.34, 1.56, 0.64, 1)" }
        );
      }

      const activeCat = catScenes[activeFaceIndex];
      const origen = new THREE.Vector3(0, calabazaHeight * 0.9, 0);
      if (activeCat && activeCat.scene) {
        new THREE.Box3().setFromObject(activeCat.scene).getCenter(origen);
        origen.y += 0.3;
      }
      lanzarFestejo(origen);
      if (!reduceMotion) popHalloween();
    }

    btnAcariciar?.addEventListener("click", () => {
      acariciar();
    });

    // Resize
    function ajustar() {
      const w = root.clientWidth, h = root.clientHeight;
      if (!w || !h) return;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    new ResizeObserver(ajustar).observe(root);
    ajustar();

    // Loop
    const reloj = new THREE.Clock();
    (function animar() {
      requestAnimationFrame(animar);
      const dt = Math.min(reloj.getDelta(), 0.05);
      const t = reloj.elapsedTime;

      const activeCat = catScenes[activeFaceIndex];

      if (activeCat && activeCat.scene && clickerReady) {
        const cat = activeCat.scene;
        const baseY = activeCat.baseY;

        if (pressT >= 0) {
          pressT += dt / PRESS_DUR;
          const k = Math.min(pressT, 1);

          if (k < 0.35) {
            // El gato desciende en la calabaza (clic mecánico)
            const e = easeInQuad(k / 0.35);
            cat.position.y = baseY - e * PRESS_DEPTH;
            cat.scale.y = calabazaScale * (1 - 0.07 * e);
          } else if (k < 0.45) {
            cat.position.y = baseY - PRESS_DEPTH;
          } else {
            // Salta de vuelta con rebote elástico
            const u = (k - 0.45) / 0.55;
            const e = 1 - Math.pow(1 - u, 3);
            cat.position.y = baseY - PRESS_DEPTH * (1 - e);
            cat.scale.y = calabazaScale * (1 - 0.07 * (1 - e));
          }

          if (pressT >= 1) {
            pressT = -1;
            cat.position.y = baseY;
            cat.scale.setScalar(calabazaScale);
          }
        } else if (!reduceMotion) {
          // Respiración / flotación sutil del michi
          cat.position.y = baseY + Math.sin(t * 2.2) * 0.025;
          cat.rotation.z = Math.sin(t * 1.3) * 0.015;
        }
      }

      // Parpadeo sutil de vela de Halloween
      if (!reduceMotion) {
        velaPoint.intensity = 24 + Math.sin(t * 7.5) * 4 + Math.cos(t * 13) * 2;
      }

      // Animación de partículas
      for (const p of festejo) {
        if (p.vida <= 0) continue;
        p.vida -= dt;
        if (p.vida <= 0) {
          p.s.visible = false;
          p.s.material.opacity = 0;
          continue;
        }
        p.vel.y -= 7.0 * dt;
        p.s.position.addScaledVector(p.vel, dt);
        p.s.material.opacity = Math.min(1, p.vida * 1.5);
      }

      aroNaranja.rotation.z = t * 0.12;
      aroPurpura.rotation.z = -t * 0.08;
      controls.update();
      renderer.render(scene, camera);
    })();
  });
</script>
