---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Crear Clicker 3D con IA — Felynez"
  description="Diseña tu propio michi clicker 3D personalizado chateando con Gemini y pruébalo al instante."
>
  <div class="relative min-h-screen overflow-clip bg-[#f6ecdd] text-[#3b2a1e]">
    <!-- Ambiente claro -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute -top-32 -left-32 h-[480px] w-[480px] rounded-full bg-[#ffd9e4]/60 blur-[120px]"></div>
      <div class="absolute top-40 -right-40 h-[520px] w-[520px] rounded-full bg-[#e3d9ff]/60 blur-[130px]"></div>
      <div class="absolute bottom-0 left-1/3 h-[380px] w-[380px] rounded-full bg-[#ffe6bd]/70 blur-[110px]"></div>
      <div class="huellas absolute inset-0 opacity-70"></div>
    </div>

    <!-- NAV -->
    <header class="relative z-20 mx-auto flex max-w-6xl items-center justify-between gap-3 px-5 pt-6 md:px-8">
      <a href="/" class="flex min-w-0 items-center gap-3 group">
        <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-[#3b2a1e] text-2xl shadow-[0_10px_30px_rgba(59,42,30,.3)] transition-transform group-hover:scale-105">
          🐱
        </span>
        <span class="leading-none">
          <span class="font-display block text-2xl font-semibold tracking-tight">Felynez</span>
          <span class="block text-xs font-bold tracking-[0.22em] text-[#3b2a1e]/55">TALLER IA 3D</span>
        </span>
      </a>

      <nav class="hidden items-center gap-7 text-sm font-bold text-[#3b2a1e]/70 md:flex">
        <a href="/" class="transition hover:text-[#3b2a1e]">Inicio</a>
        <a href="/#manada" class="transition hover:text-[#3b2a1e]">Los michis</a>
        <a href="/crear" class="text-[#d63a68] font-extrabold">Crear con IA</a>
      </nav>

      <div class="flex shrink-0 items-center gap-3">
        <a
          href="/"
          class="rounded-full border border-[#3b2a1e]/15 bg-white/60 px-5 py-2.5 text-sm font-extrabold backdrop-blur transition hover:bg-white"
        >
          ← Volver
        </a>
      </div>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="relative z-10 mx-auto max-w-6xl px-5 pt-8 pb-16 md:px-8">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-[#ff5c8a]/30 bg-[#ff5c8a]/10 px-4 py-1.5 text-xs font-extrabold text-[#d63a68]">
            <span>✨</span>
            <span>GENERADOR 3D · GEMINI 4 HYDROGEN</span>
          </span>
          <h1 class="font-display mt-3 text-4xl font-semibold tracking-tight md:text-5xl">
            Crea tu propio <span class="text-[#ff5c8a]">Michi Clicker</span>
          </h1>
        </div>
        <p class="max-w-md text-sm font-bold text-[#3b2a1e]/65">
          Escribe qué temática, colores o accesorios quieres en el chat. La IA lo arma en 3D al instante para que lo pruebes y lo clickees.
        </p>
      </div>

      <div class="grid items-start gap-8 lg:grid-cols-[0.95fr_1.05fr]">
        <!-- PANEL IZQUIERDO: CHAT -->
        <section class="flex h-[580px] flex-col overflow-hidden rounded-[32px] border border-[#3b2a1e]/10 bg-white shadow-[0_30px_90px_rgba(59,42,30,.14)]">
          <div class="flex items-center justify-between border-b border-[#3b2a1e]/10 px-5 py-4">
            <div class="flex items-center gap-2.5">
              <span class="grid h-9 w-9 place-items-center rounded-xl bg-[#ffb84d]/25 text-lg">🤖</span>
              <div>
                <p class="font-display text-base font-semibold leading-tight">Diseñador Felynez IA</p>
                <p class="text-[11px] font-bold text-[#3b2a1e]/55">Modelo: gemini-4-hydrogen</p>
              </div>
            </div>
            <button
              type="button"
              id="btn-reset-chat"
              class="rounded-full border border-[#3b2a1e]/15 bg-[#f6ecdd] px-3 py-1.5 text-xs font-extrabold text-[#3b2a1e]/75 transition hover:bg-[#ffb84d]/30 hover:text-[#3b2a1e] cursor-pointer"
            >
              Reiniciar
            </button>
          </div>

          <!-- Mensajes -->
          <div id="chat-messages" class="flex-1 space-y-3 overflow-y-auto p-5">
            <div class="flex justify-start">
              <div class="max-w-[85%] rounded-2xl rounded-tl-sm border border-[#3b2a1e]/10 bg-[#f6ecdd] px-4 py-3 text-sm leading-relaxed text-[#3b2a1e]">
                ¡Hola! 🐾 Cuéntame cómo imaginas tu clicker 3D. Por ejemplo: <em>“haz un michi astronauta saliendo de un cohete azul”</em> o <em>“ponle lentes de sol al michi actual”</em>.
              </div>
            </div>
          </div>

          <!-- Sugerencias rápidas -->
          <div class="flex flex-wrap gap-1.5 border-t border-[#3b2a1e]/10 bg-[#faf5ec] px-4 py-2.5">
            <button type="button" data-prompt="Haz un michi astronauta con casco blanco saliendo de un cohete azul" class="rounded-full border border-[#3b2a1e]/10 bg-white px-3 py-1 text-xs font-bold text-[#3b2a1e]/80 transition hover:border-[#ff5c8a] hover:text-[#d63a68] cursor-pointer">
              🚀 Michi astronauta
            </button>
            <button type="button" data-prompt="Haz un gatito chef con gorro blanco saliendo de una taza de café" class="rounded-full border border-[#3b2a1e]/10 bg-white px-3 py-1 text-xs font-bold text-[#3b2a1e]/80 transition hover:border-[#ff5c8a] hover:text-[#d63a68] cursor-pointer">
              ☕ Michi chef en taza
            </button>
            <button type="button" data-prompt="Haz un michi rey negro con corona dorada saliendo de un cofre" class="rounded-full border border-[#3b2a1e]/10 bg-white px-3 py-1 text-xs font-bold text-[#3b2a1e]/80 transition hover:border-[#ff5c8a] hover:text-[#d63a68] cursor-pointer">
              👑 Michi rey
            </button>
            <button type="button" data-prompt="Ponle lentes de sol oscuros y cambia la base a color rosa pastel" class="rounded-full border border-[#3b2a1e]/10 bg-white px-3 py-1 text-xs font-bold text-[#3b2a1e]/80 transition hover:border-[#ff5c8a] hover:text-[#d63a68] cursor-pointer">
              😎 Con lentes
            </button>
          </div>

          <!-- Input del chat -->
          <form id="chat-form" class="flex items-center gap-2 border-t border-[#3b2a1e]/10 p-3">
            <input
              id="chat-input"
              type="text"
              required
              autocomplete="off"
              placeholder="Describe tu clicker 3D ideal..."
              class="flex-1 rounded-2xl border border-[#3b2a1e]/15 bg-[#f6ecdd]/60 px-4 py-3 text-sm font-bold text-[#3b2a1e] outline-none placeholder:text-[#3b2a1e]/40 focus:border-[#ff5c8a] focus:bg-white"
            />
            <button
              id="chat-submit"
              type="submit"
              class="rounded-2xl bg-[#ff5c8a] px-5 py-3 font-display text-sm font-semibold text-white shadow-[0_8px_20px_rgba(255,92,138,.35)] transition hover:brightness-110 active:scale-95 disabled:opacity-50 cursor-pointer"
            >
              Crear ✨
            </button>
          </form>
        </section>

        <!-- PANEL DERECHO: VISOR 3D CLICKER -->
        <section class="grano relative overflow-hidden rounded-[32px] border border-[#3b2a1e]/10 bg-white p-3 shadow-[0_30px_90px_rgba(59,42,30,.18)]">
          <div class="flex items-center justify-between px-3 pt-2 pb-3">
            <span id="viewer-title" class="text-xs font-bold text-[#3b2a1e]/65">Mishi Clásico · pruébalo aquí</span>
            <span class="font-display text-xs font-semibold text-[#d63a68]">★ clickea al michi</span>
          </div>

          <!-- Canvas 3D -->
          <div
            id="custom-clicker-root"
            class="group relative h-[430px] md:h-[460px] w-full overflow-hidden rounded-[28px] border border-[#3b2a1e]/10 bg-gradient-to-b from-[#f7e9cf] to-[#e9c896] select-none"
          >
            <canvas class="block h-full w-full touch-none cursor-grab active:cursor-grabbing" aria-label="Visor 3D del clicker personalizado"></canvas>

            <!-- Halo -->
            <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_55%_at_50%_38%,rgba(255,92,138,0.22),transparent_70%),radial-gradient(50%_40%_at_70%_80%,rgba(124,92,255,0.25),transparent_70%)]"></div>

            <!-- Marcador superior -->
            <div class="pointer-events-none absolute top-3 right-3 left-3 z-20 flex items-center justify-between gap-2">
              <div class="flex items-center gap-2 rounded-full border border-black/10 bg-white/80 px-3 py-1.5 shadow-sm backdrop-blur-md sm:px-4 sm:py-2">
                <span class="text-base sm:text-lg">🐾</span>
                <span class="font-display text-base font-semibold text-[#b45309] sm:text-lg" data-count>0</span>
                <span class="hidden text-xs font-extrabold tracking-widest text-[#3b2a1e]/60 min-[420px]:inline">CARICIAS</span>
              </div>

              <div id="viewer-subtitle" class="flex items-center gap-1.5 rounded-full border border-black/10 bg-white/80 px-3 py-1 text-[11px] font-bold text-[#3b2a1e]/75 shadow-sm backdrop-blur-md">
                <span>✨ Personalizado</span>
              </div>
            </div>

            <!-- Botón Acariciar -->
            <div class="absolute right-3 bottom-3 z-20">
              <button
                type="button"
                data-btn-acariciar
                class="group/btn flex items-center gap-2 rounded-full bg-[#3b2a1e] px-5 py-2 text-xs font-extrabold text-[#fff8ee] shadow-[0_8px_24px_rgba(59,42,30,.35)] transition hover:brightness-125 active:scale-95 cursor-pointer"
              >
                <span>¡Acariciar!</span>
                <span class="text-base group-hover/btn:rotate-12 transition-transform">💛</span>
              </button>
            </div>

            <!-- Overlay mientras Gemini genera -->
            <div id="ai-loading" class="absolute inset-0 z-30 hidden flex-col items-center justify-center gap-3 bg-[#f3e2c7]/85 backdrop-blur-sm">
              <div class="relative">
                <svg width="78" height="78" viewBox="0 0 88 88" class="animate-[giro_2s_linear_infinite]">
                  <circle cx="44" cy="44" r="36" fill="none" stroke="rgba(59,42,30,.15)" stroke-width="7" />
                  <path d="M44 8 a36 36 0 0 1 31 18" fill="none" stroke="#ff5c8a" stroke-width="7" stroke-linecap="round" />
                </svg>
                <div class="absolute inset-0 grid place-items-center text-2xl">✨</div>
              </div>
              <p class="font-display text-lg text-[#3b2a1e]">Modelando tu michi en 3D…</p>
              <p class="text-xs font-bold text-[#3b2a1e]/60">creando piezas con Gemini</p>
            </div>
          </div>

          <!-- Pie del visor + botón WhatsApp -->
          <div class="flex flex-wrap items-center justify-between gap-3 px-3 py-3">
            <p class="text-xs font-bold text-[#3b2a1e]/60">Arrastra para girar · Clickea para probar el resorte</p>
            <button
              type="button"
              id="btn-pedir-custom"
              class="rounded-full bg-[#3b2a1e] px-5 py-2.5 font-display text-sm font-semibold text-[#fff8ee] transition hover:bg-[#ff5c8a] cursor-pointer"
            >
              Cotizar este diseño por WhatsApp 🐾
            </button>
          </div>
        </section>
      </div>
    </main>
  </div>
</Layout>

<script type="module">
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  function easeInQuad(x) { return x * x; }

  // Modelo inicial por defecto (Michi en cajita)
  const DEFAULT_SPEC = {
    name: "Mishi Clásico en Caja",
    subtitle: "Diseño Base",
    pressDepth: 0.3,
    popFreq: 440,
    emojis: ["💗", "🐾", "✨"],
    scene: {
      rugColor: "#c99e67",
      ringColor: "#ffb84d",
      accentLight: "#ff5c8a"
    },
    baseParts: [
      { shape: "box", color: "#d4a373", pos: [0, 0.5, 0], rot: [0, 0, 0], scale: [1.85, 1.0, 1.85], roughness: 0.65, metalness: 0.05 },
      { shape: "box", color: "#bc8a5f", pos: [0, 0.98, 0], rot: [0, 0, 0], scale: [1.95, 0.12, 1.95], roughness: 0.6, metalness: 0.05 }
    ],
    catParts: [
      // Cabeza
      { shape: "sphere", color: "#fff8ee", pos: [0, 1.48, 0], rot: [0, 0, 0], scale: [1.18, 1.02, 1.08], roughness: 0.4, metalness: 0.05 },
      // Orejas
      { shape: "cone", color: "#ffb84d", pos: [-0.38, 2.02, 0.02], rot: [0, 0, 0.25], scale: [0.34, 0.45, 0.34], roughness: 0.45, metalness: 0.05 },
      { shape: "cone", color: "#ffb84d", pos: [0.38, 2.02, 0.02], rot: [0, 0, -0.25], scale: [0.34, 0.45, 0.34], roughness: 0.45, metalness: 0.05 },
      // Ojos
      { shape: "sphere", color: "#2b1d14", pos: [-0.2, 1.54, 0.48], rot: [0, 0, 0], scale: [0.13, 0.16, 0.1], roughness: 0.2, metalness: 0.1 },
      { shape: "sphere", color: "#2b1d14", pos: [0.2, 1.54, 0.48], rot: [0, 0, 0], scale: [0.13, 0.16, 0.1], roughness: 0.2, metalness: 0.1 },
      // Naricita
      { shape: "sphere", color: "#ff5c8a", pos: [0, 1.4, 0.54], rot: [0, 0, 0], scale: [0.12, 0.09, 0.09], roughness: 0.3, metalness: 0.05 },
      // Patitas
      { shape: "sphere", color: "#fff8ee", pos: [-0.32, 1.06, 0.46], rot: [0, 0, 0], scale: [0.24, 0.18, 0.28], roughness: 0.45, metalness: 0.05 },
      { shape: "sphere", color: "#fff8ee", pos: [0.32, 1.06, 0.46], rot: [0, 0, 0], scale: [0.24, 0.18, 0.28], roughness: 0.45, metalness: 0.05 }
    ]
  };

  let currentSpec = structuredClone(DEFAULT_SPEC);

  // --- Inicializar Three.js ---
  const root = document.getElementById("custom-clicker-root");
  const canvas = root.querySelector("canvas");
  const elCount = root.querySelector("[data-count]");
  const btnAcariciar = root.querySelector("[data-btn-acariciar]");
  const viewerTitle = document.getElementById("viewer-title");
  const viewerSubtitle = document.getElementById("viewer-subtitle");
  const aiLoading = document.getElementById("ai-loading");

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.15;
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;

  const scene = new THREE.Scene();
  scene.fog = new THREE.FogExp2(0xf0d9b4, 0.04);

  const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 60);
  camera.position.set(0.7, 2.2, 5.8);

  const controls = new OrbitControls(camera, canvas);
  controls.target.set(0, 1.1, 0);
  controls.enableDamping = true;
  controls.dampingFactor = 0.06;
  controls.minDistance = 2.6;
  controls.maxDistance = 9;
  controls.maxPolarAngle = Math.PI * 0.52;
  controls.minPolarAngle = Math.PI * 0.1;
  controls.enablePan = false;
  controls.autoRotate = !reduceMotion;
  controls.autoRotateSpeed = 1.2;

  scene.add(new THREE.HemisphereLight(0xfff6e9, 0x8a6f4d, 1.15));
  const key = new THREE.DirectionalLight(0xffe9c4, 2.3);
  key.position.set(3.5, 6, 4);
  key.castShadow = true;
  key.shadow.mapSize.set(1024, 1024);
  scene.add(key);

  const rimLight = new THREE.PointLight(0xff5c8a, 24, 22);
  rimLight.position.set(-3.5, 2.4, -2.5);
  scene.add(rimLight);

  const fillLight = new THREE.PointLight(0x7c5cff, 18, 22);
  fillLight.position.set(3, 1.4, -3);
  scene.add(fillLight);

  const rugMat = new THREE.MeshStandardMaterial({ color: 0xc99e67, roughness: 0.95, metalness: 0 });
  const alfombra = new THREE.Mesh(new THREE.CircleGeometry(2.2, 64), rugMat);
  alfombra.rotation.x = -Math.PI / 2;
  alfombra.receiveShadow = true;
  scene.add(alfombra);

  const ringMat = new THREE.MeshBasicMaterial({ color: 0xffb84d, transparent: true, opacity: 0.55, side: THREE.DoubleSide });
  const aro = new THREE.Mesh(new THREE.RingGeometry(2.2, 2.32, 64), ringMat);
  aro.rotation.x = -Math.PI / 2;
  aro.position.y = 0.01;
  scene.add(aro);

  // Grupos de base y gato
  const baseGroup = new THREE.Group();
  const catGroup = new THREE.Group();
  scene.add(baseGroup);
  scene.add(catGroup);

  function createGeometry(shape) {
    switch (shape) {
      case "sphere": return new THREE.SphereGeometry(0.5, 28, 22);
      case "cylinder": return new THREE.CylinderGeometry(0.5, 0.5, 1, 28);
      case "cone": return new THREE.ConeGeometry(0.5, 1, 24);
      case "torus": return new THREE.TorusGeometry(0.4, 0.14, 16, 36);
      case "capsule": return new THREE.CapsuleGeometry(0.28, 0.6, 12, 20);
      case "octahedron": return new THREE.OctahedronGeometry(0.5, 0);
      case "box":
      default: return new THREE.BoxGeometry(1, 1, 1);
    }
  }

  function clearGroup(group) {
    while (group.children.length > 0) {
      const child = group.children[0];
      group.remove(child);
      if (child.geometry) child.geometry.dispose();
      if (child.material) child.material.dispose();
    }
  }

  function buildParts(group, parts, castReceiveShadow = false) {
    clearGroup(group);
    if (!Array.isArray(parts)) return;
    for (const p of parts) {
      const geo = createGeometry(p.shape);
      const mat = new THREE.MeshStandardMaterial({
        color: p.color || "#ffffff",
        roughness: typeof p.roughness === "number" ? p.roughness : 0.45,
        metalness: typeof p.metalness === "number" ? p.metalness : 0.05,
      });
      const mesh = new THREE.Mesh(geo, mat);
      const pos = Array.isArray(p.pos) ? p.pos : [0, 0.5, 0];
      const rot = Array.isArray(p.rot) ? p.rot : [0, 0, 0];
      const scale = Array.isArray(p.scale) ? p.scale : [1, 1, 1];
      mesh.position.set(Number(pos[0]) || 0, Number(pos[1]) || 0, Number(pos[2]) || 0);
      mesh.rotation.set(Number(rot[0]) || 0, Number(rot[1]) || 0, Number(rot[2]) || 0);
      mesh.scale.set(Number(scale[0]) || 1, Number(scale[1]) || 1, Number(scale[2]) || 1);
      mesh.castShadow = true;
      mesh.receiveShadow = castReceiveShadow;
      group.add(mesh);
    }
  }

  // Partículas de festejo
  function emojiTexture(emoji) {
    const c = document.createElement("canvas");
    c.width = c.height = 128;
    const ctx = c.getContext("2d");
    ctx.font = "88px serif";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(emoji, 64, 68);
    const tex = new THREE.CanvasTexture(c);
    tex.colorSpace = THREE.SRGBColorSpace;
    return tex;
  }

  const FESTEJO_N = 26;
  const festejo = [];
  for (let i = 0; i < FESTEJO_N; i++) {
    const mat = new THREE.SpriteMaterial({ transparent: true, opacity: 0, depthWrite: false });
    const s = new THREE.Sprite(mat);
    s.scale.setScalar(0.28 + Math.random() * 0.2);
    s.visible = false;
    scene.add(s);
    festejo.push({ s, vel: new THREE.Vector3(), vida: 0 });
  }

  function updateCelebrationEmojis(emojis) {
    const list = Array.isArray(emojis) && emojis.length > 0 ? emojis : ["💗", "🐾", "✨"];
    const textures = list.slice(0, 5).map(emojiTexture);
    festejo.forEach((p, idx) => {
      p.s.material.map = textures[idx % textures.length];
      p.s.material.needsUpdate = true;
    });
  }

  function lanzarFestejo(origen) {
    let lanzadas = 0;
    for (const p of festejo) {
      if (p.vida > 0) continue;
      p.vida = 0.9 + Math.random() * 0.5;
      p.s.visible = true;
      p.s.position.copy(origen).add(new THREE.Vector3((Math.random() - 0.5) * 0.6, Math.random() * 0.3, (Math.random() - 0.5) * 0.6));
      p.vel.set((Math.random() - 0.5) * 3.2, 3.2 + Math.random() * 2.2, (Math.random() - 0.5) * 3.2);
      if (++lanzadas >= 14) break;
    }
  }

  // Sonido de clicker mecánico agradable (bajada + rebote)
  let audioCtx = null;
  function pop() {
    try {
      audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === "suspended") audioCtx.resume();
      const t = audioCtx.currentTime;

      function golpeSwitch(at, freqClick, freqThock, vol) {
        const len = Math.floor(audioCtx.sampleRate * 0.016);
        const buf = audioCtx.createBuffer(1, len, audioCtx.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < len; i++) {
          data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (len * 0.25));
        }
        const noise = audioCtx.createBufferSource();
        noise.buffer = buf;
        const bp = audioCtx.createBiquadFilter();
        bp.type = "bandpass";
        bp.frequency.setValueAtTime(freqClick, at);
        bp.Q.setValueAtTime(1.8, at);
        const ng = audioCtx.createGain();
        ng.gain.setValueAtTime(vol * 0.85, at);
        ng.gain.exponentialRampToValueAtTime(0.001, at + 0.016);
        noise.connect(bp).connect(ng).connect(audioCtx.destination);
        noise.start(at);

        const osc = audioCtx.createOscillator();
        const og = audioCtx.createGain();
        osc.type = "triangle";
        osc.frequency.setValueAtTime(freqThock, at);
        osc.frequency.exponentialRampToValueAtTime(75, at + 0.038);
        og.gain.setValueAtTime(vol * 0.55, at);
        og.gain.exponentialRampToValueAtTime(0.001, at + 0.042);
        osc.connect(og).connect(audioCtx.destination);
        osc.start(at);
        osc.stop(at + 0.045);
      }

      const jitter = (Math.random() - 0.5) * 180;
      golpeSwitch(t, 2400 + jitter, 210, 0.32);
      golpeSwitch(t + 0.14, 3200 + jitter, 280, 0.22);
    } catch {}
  }

  function applySpec(spec) {
    currentSpec = spec;
    buildParts(baseGroup, spec.baseParts, true);
    buildParts(catGroup, spec.catParts, false);

    if (spec.scene?.rugColor) rugMat.color.set(spec.scene.rugColor);
    if (spec.scene?.ringColor) ringMat.color.set(spec.scene.ringColor);
    if (spec.scene?.accentLight) rimLight.color.set(spec.scene.accentLight);

    updateCelebrationEmojis(spec.emojis);
    if (viewerTitle) viewerTitle.textContent = `${spec.name || "Michi Personalizado"} · pruébalo en 3D`;
    if (viewerSubtitle) viewerSubtitle.innerHTML = `<span>✨ ${spec.subtitle || "Personalizado"}</span>`;
  }

  applySpec(DEFAULT_SPEC);

  // Interacción clicker
  let caricias = 0;
  let pressT = -1;
  const PRESS_DUR = 0.52;

  const rayo = new THREE.Raycaster();
  const puntero = new THREE.Vector2();
  let downX = 0, downY = 0;

  function golpeaModelo(e) {
    const r = canvas.getBoundingClientRect();
    const cx = e.clientX !== undefined ? e.clientX : e.touches?.[0]?.clientX;
    const cy = e.clientY !== undefined ? e.clientY : e.touches?.[0]?.clientY;
    puntero.set(((cx - r.left) / r.width) * 2 - 1, -((cy - r.top) / r.height) * 2 + 1);
    rayo.setFromCamera(puntero, camera);
    return (
      rayo.intersectObject(catGroup, true).length > 0 ||
      rayo.intersectObject(baseGroup, true).length > 0
    );
  }

  canvas.addEventListener("pointerdown", (e) => { downX = e.clientX; downY = e.clientY; });
  canvas.addEventListener("pointerup", (e) => {
    const mov = Math.hypot(e.clientX - downX, e.clientY - downY);
    if (mov > 7) return;
    if (golpeaModelo(e)) acariciar();
  });

  function acariciar() {
    if (pressT >= 0 && pressT < 0.4) return;
    pressT = 0;
    caricias++;
    if (elCount) {
      elCount.textContent = String(caricias);
      elCount.parentElement.animate(
        [{ transform: "scale(1)" }, { transform: "scale(1.25)" }, { transform: "scale(1)" }],
        { duration: 300, easing: "ease-out" }
      );
    }
    const centro = new THREE.Vector3();
    new THREE.Box3().setFromObject(catGroup).getCenter(centro);
    centro.y += 0.35;
    lanzarFestejo(centro);
    if (!reduceMotion) pop();
  }

  btnAcariciar?.addEventListener("click", acariciar);

  function ajustar() {
    const w = root.clientWidth, h = root.clientHeight;
    if (!w || !h) return;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }
  new ResizeObserver(ajustar).observe(root);
  ajustar();

  const reloj = new THREE.Clock();
  (function animar() {
    requestAnimationFrame(animar);
    const dt = Math.min(reloj.getDelta(), 0.05);
    const t = reloj.elapsedTime;
    const depth = Math.min(Math.max(Number(currentSpec.pressDepth) || 0.3, 0.15), 0.55);

    if (pressT >= 0) {
      pressT += dt / PRESS_DUR;
      const k = Math.min(pressT, 1);
      if (k < 0.35) {
        const e = easeInQuad(k / 0.35);
        catGroup.position.y = -e * depth;
        catGroup.scale.y = 1 - 0.06 * e;
      } else if (k < 0.45) {
        catGroup.position.y = -depth;
      } else {
        const u = (k - 0.45) / 0.55;
        const e = 1 - Math.pow(1 - u, 3);
        catGroup.position.y = -depth * (1 - e);
        catGroup.scale.y = 1 - 0.06 * (1 - e);
      }
      if (pressT >= 1) {
        pressT = -1;
        catGroup.position.y = 0;
        catGroup.scale.set(1, 1, 1);
      }
    } else if (!reduceMotion) {
      catGroup.position.y = Math.sin(t * 1.9) * 0.025;
      catGroup.rotation.z = Math.sin(t * 1.1) * 0.015;
    }

    for (const p of festejo) {
      if (p.vida <= 0) continue;
      p.vida -= dt;
      if (p.vida <= 0) { p.s.visible = false; p.s.material.opacity = 0; continue; }
      p.vel.y -= 6.5 * dt;
      p.s.position.addScaledVector(p.vel, dt);
      p.s.material.opacity = Math.min(1, p.vida * 1.6);
    }

    aro.rotation.z = t * 0.1;
    controls.update();
    renderer.render(scene, camera);
  })();

  // --- Lógica de Chat con /api/generar-clicker ---
  const chatForm = document.getElementById("chat-form");
  const chatInput = document.getElementById("chat-input");
  const chatSubmit = document.getElementById("chat-submit");
  const chatMessages = document.getElementById("chat-messages");
  const btnResetChat = document.getElementById("btn-reset-chat");
  const btnPedirCustom = document.getElementById("btn-pedir-custom");

  let history = [];

  function appendBubble(role, text, isError = false) {
    const wrapper = document.createElement("div");
    wrapper.className = role === "user" ? "flex justify-end" : "flex justify-start";
    const bubble = document.createElement("div");
    if (role === "user") {
      bubble.className = "max-w-[85%] rounded-2xl rounded-tr-sm bg-[#3b2a1e] px-4 py-3 text-sm font-semibold leading-relaxed text-[#fff8ee]";
    } else if (isError) {
      bubble.className = "max-w-[85%] rounded-2xl rounded-tl-sm border border-red-300 bg-red-50 px-4 py-3 text-sm font-semibold leading-relaxed text-red-800";
    } else {
      bubble.className = "max-w-[85%] rounded-2xl rounded-tl-sm border border-[#3b2a1e]/10 bg-[#f6ecdd] px-4 py-3 text-sm leading-relaxed text-[#3b2a1e]";
    }
    bubble.textContent = text;
    wrapper.appendChild(bubble);
    chatMessages.appendChild(wrapper);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  async function sendPrompt(text) {
    const trimmed = text.trim();
    if (!trimmed) return;

    appendBubble("user", trimmed);
    history.push({ role: "user", text: trimmed });
    chatInput.value = "";
    chatInput.disabled = true;
    chatSubmit.disabled = true;
    aiLoading.classList.remove("hidden");
    aiLoading.classList.add("flex");

    try {
      const res = await fetch("/api/generar-clicker", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: history, currentSpec }),
      });

      const data = await res.json();
      if (!res.ok || data.error) {
        appendBubble("assistant", data.error || "No se pudo generar el clicker. Intenta de nuevo.", true);
        history.pop();
        return;
      }

      if (data.spec) {
        applySpec(data.spec);
        acariciar();
      }
      const reply = data.reply || "¡Listo! Ya actualicé tu michi clicker en el visor 3D.";
      appendBubble("assistant", reply);
      history.push({ role: "assistant", text: reply });
    } catch {
      appendBubble("assistant", "Error de conexión al generar el clicker.", true);
      history.pop();
    } finally {
      chatInput.disabled = false;
      chatSubmit.disabled = false;
      aiLoading.classList.add("hidden");
      aiLoading.classList.remove("flex");
      chatInput.focus();
    }
  }

  chatForm.addEventListener("submit", (e) => {
    e.preventDefault();
    sendPrompt(chatInput.value);
  });

  document.querySelectorAll("[data-prompt]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const p = btn.getAttribute("data-prompt");
      if (p) sendPrompt(p);
    });
  });

  btnResetChat?.addEventListener("click", () => {
    history = [];
    applySpec(DEFAULT_SPEC);
    chatMessages.innerHTML = "";
    appendBubble("assistant", "¡Reiniciado! 🐾 Dime qué nuevo clicker 3D quieres diseñar.");
  });

  btnPedirCustom?.addEventListener("click", () => {
    const msg = `¡Hola! 🐾 Acabo de diseñar un clicker 3D personalizado en Felynez IA: "${currentSpec.name}" (${currentSpec.subtitle}). ¿Me pueden cotizar cuánto saldría imprimirlo?`;
    window.open(`https://api.whatsapp.com/send?phone=51933468699&text=${encodeURIComponent(msg)}`, "_blank");
  });
</script>
