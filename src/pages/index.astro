---
import Layout from "../layouts/Layout.astro";
import GatoClicker from "../components/GatoClicker.astro";
import PumpkinClicker from "../components/PumpkinClicker.astro";
---

<Layout title="Felynez Halloween 🎃 — Michi Calabaza 3D con 3 Caritas & Clickers Antiestrés">
  <div class="relative min-h-screen overflow-clip bg-[#0d0714] text-[#fff0db] noche-estrellada">
    <!-- Luces y atmósfera embrujada de fondo -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -top-32 -left-32 h-[520px] w-[520px] rounded-full bg-[#ff7518]/18 blur-[140px]"></div>
      <div class="absolute top-48 -right-40 h-[560px] w-[560px] rounded-full bg-[#8b5cf6]/20 blur-[150px]"></div>
      <div class="absolute top-1/2 left-1/4 h-[420px] w-[420px] rounded-full bg-[#2ee6a8]/10 blur-[130px]"></div>
      <div class="absolute bottom-10 right-1/3 h-[500px] w-[500px] rounded-full bg-[#ff5500]/15 blur-[160px]"></div>
      
      <!-- Murciélagos decorativos flotantes -->
      <div class="absolute top-24 left-[8%] text-2xl opacity-40 animate-flota">🦇</div>
      <div class="absolute top-40 right-[12%] text-3xl opacity-35 animate-flota-lenta">🦇</div>
      <div class="absolute top-[55%] left-[5%] text-xl opacity-30 animate-flota">🦇</div>
      <div class="absolute top-[75%] right-[6%] text-2xl opacity-30 animate-flota-lenta">👻</div>
      
      <!-- Telaraña en esquina superior derecha -->
      <div class="telarana-bg absolute top-0 right-0 h-96 w-96 opacity-60"></div>
    </div>

    <!-- BANNER DE HALLOWEEN -->
    <div class="relative z-30 border-b border-[#ff7518]/25 bg-gradient-to-r from-[#200e33] via-[#ff7518]/20 to-[#200e33] py-2 px-4 text-center text-xs font-black tracking-widest text-[#ffaa44] backdrop-blur-md">
      <span class="inline-flex items-center gap-2">
        <span class="animate-pulse">🎃</span>
        <span>EDICIÓN ESPECIAL HALLOWEEN · ¡NUEVO MISHI CALABAZA CON 3 CARITAS DE GATO!</span>
        <span class="animate-pulse">🦇</span>
      </span>
    </div>

    <!-- NAV -->
    <header class="relative z-20 mx-auto flex max-w-6xl items-center justify-between gap-3 px-5 pt-6 md:px-8">
      <a href="/" class="flex min-w-0 items-center gap-3 group">
        <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-[#ff7518] to-[#9333ea] text-2xl shadow-[0_0_25px_rgba(255,117,24,0.45)] transition-transform group-hover:scale-105">
          🎃
        </span>
        <span class="leading-none">
          <span class="font-display block text-2xl font-black tracking-tight text-white group-hover:text-[#ffaa44] transition-colors">
            Felynez
          </span>
          <span class="block text-[11px] font-black tracking-[0.22em] text-[#ff7518]">HALLOWEEN 3D</span>
        </span>
      </a>

      <nav class="hidden items-center gap-8 text-sm font-extrabold text-[#ffd9b3]/75 md:flex">
        <a href="#manada" class="transition hover:text-[#ff7518] hover:drop-shadow-[0_0_8px_rgba(255,117,24,0.8)]">Los Michis</a>
        <a href="#calabaza-visor" class="transition hover:text-[#ff7518] hover:drop-shadow-[0_0_8px_rgba(255,117,24,0.8)]">Mishi Calabaza</a>
        <a href="#como-funciona" class="transition hover:text-[#ff7518] hover:drop-shadow-[0_0_8px_rgba(255,117,24,0.8)]">Cómo funciona</a>
        <a href="#preguntas" class="transition hover:text-[#ff7518] hover:drop-shadow-[0_0_8px_rgba(255,117,24,0.8)]">Preguntas</a>
      </nav>

      <div class="flex shrink-0 items-center gap-3">
        <a
          href="#manada"
          class="hidden rounded-full border border-[#ff7518]/30 bg-[#1e1133]/60 px-5 py-2.5 text-sm font-black text-[#ffd9b3] backdrop-blur transition hover:bg-[#ff7518]/20 hover:text-white sm:block"
        >
          Ver michis 🐾
        </a>
        <a
          href="#pedido"
          class="rounded-full bg-gradient-to-r from-[#ff7518] via-[#ff8c1a] to-[#ff5500] px-5 py-2.5 text-sm font-black text-[#0d0714] shadow-[0_0_30px_rgba(255,117,24,0.5)] transition hover:brightness-110 active:scale-95"
        >
          Pedir el mío 🎃
        </a>
      </div>
    </header>

    <!-- HERO SECTION -->
    <section id="calabaza-visor" class="relative z-10 mx-auto grid max-w-6xl items-center gap-10 px-5 pt-10 pb-12 md:grid-cols-[1.05fr_.95fr] md:px-8 md:pt-14">
      <div>
        <h1 class="font-display text-balance mt-4 text-5xl leading-[0.95] font-black tracking-tight md:text-7xl">
          Un gato calabaza<br />
          <span class="relative inline-block text-transparent bg-clip-text bg-gradient-to-r from-[#ff7518] via-[#ffaa44] to-[#ff5500] drop-shadow-[0_0_30px_rgba(255,117,24,0.6)]">
            embrujado
            <svg viewBox="0 0 220 22" class="absolute -bottom-2 left-0 w-full" fill="none" aria-hidden="true">
              <path d="M4 15 C 60 4, 150 4, 216 12" stroke="#ff7518" stroke-width="7" stroke-linecap="round" />
            </svg>
          </span><br />
          que salta a saludarte.
        </h1>

        <p class="mt-7 max-w-md text-lg leading-relaxed text-[#ffd9b3]/80">
          Somos <strong class="text-white">Felynez</strong> y hacemos juguetes gatunos en 3D.
          Para esta temporada creamos el <strong class="text-[#ffaa44]">Mishi Calabaza</strong>: incluye 1 calabaza tallada y <strong class="text-white">3 caritas de gato intercambiables</strong>.
          Clickea al gato en el visor 3D para probar su resorte táctil y cambia sus expresiones.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="#pedido"
            class="rounded-full bg-gradient-to-r from-[#ff7518] to-[#e65100] px-7 py-3.5 font-display text-lg font-black text-[#0d0714] shadow-[0_12px_35px_rgba(255,117,24,0.4)] transition hover:-translate-y-0.5 hover:brightness-110 active:scale-95"
          >
            Quiero mi Calabaza 🎃
          </a>
          <a
            href="#manada"
            class="rounded-full border border-purple-500/40 bg-[#1a0f2e]/70 px-7 py-3.5 font-display text-lg font-bold text-[#ffd9b3] backdrop-blur transition hover:bg-purple-900/30 hover:text-white"
          >
            Ver los 2 clickers
          </a>
        </div>

        <dl class="mt-10 flex flex-wrap gap-x-8 gap-y-4">
          <div class="rounded-2xl border border-[#ff7518]/20 bg-[#170c26]/60 p-3.5 min-w-[130px]">
            <dt class="font-display text-3xl font-black text-[#ffaa44]">1 + 3</dt>
            <dd class="text-xs font-bold text-[#ffd9b3]/70">1 calabaza + 3 caritas de gato</dd>
          </div>
          <div class="rounded-2xl border border-purple-500/20 bg-[#170c26]/60 p-3.5 min-w-[130px]">
            <dt class="font-display text-3xl font-black text-purple-400">PLA+</dt>
            <dd class="text-xs font-bold text-[#ffd9b3]/70">filamento premium, tacto suave</dd>
          </div>
          <div class="rounded-2xl border border-[#2ee6a8]/20 bg-[#170c26]/60 p-3.5 min-w-[130px]">
            <dt class="font-display text-3xl font-black text-[#2ee6a8]">100%</dt>
            <dd class="text-xs font-bold text-[#ffd9b3]/70">antiestrés garantizado</dd>
          </div>
        </dl>
      </div>

      <!-- HERO 3D : Gato Calabaza Clicker -->
      <div class="relative">
        <div class="grano relative overflow-hidden rounded-[34px] border border-[#ff7518]/30 bg-[#150d24] p-3 shadow-[0_25px_80px_rgba(0,0,0,0.8),0_0_40px_rgba(255,117,24,0.18)]">
          <div class="flex items-center justify-between px-3 pt-2 pb-3">
            <span class="text-xs font-extrabold text-[#ffaa44] flex items-center gap-1.5">
              <span>🎃</span>
              <span>Mishi Calabaza · ¡Pruébalo en 3D!</span>
            </span>
            <div class="font-display text-xs font-black text-purple-300">
              ★ clickea la carita
            </div>
          </div>

          <!-- Componente 3D Pumpkin Clicker -->
          <PumpkinClicker alto="h-[400px] md:h-[480px]" />

          <div class="flex items-center justify-between gap-3 px-3 py-3">
            <div class="flex -space-x-2.5">
              <span class="grid h-9 w-9 place-items-center rounded-full border-2 border-[#150d24] bg-[#ff7518] text-base shadow">🎃</span>
              <span class="grid h-9 w-9 place-items-center rounded-full border-2 border-[#150d24] bg-[#9333ea] text-base shadow">🐈‍⬛</span>
              <span class="grid h-9 w-9 place-items-center rounded-full border-2 border-[#150d24] bg-[#2ee6a8] text-base shadow">👻</span>
              <span class="grid h-9 w-9 place-items-center rounded-full border-2 border-[#150d24] bg-[#231539] text-xs font-black text-[#ffaa44]">+3k</span>
            </div>
            <p class="text-xs font-bold text-[#ffd9b3]/60">Más de 3,500 sustos y caricias contadas</p>
          </div>
        </div>

        <!-- Sticker flotante decorativo -->
        <div class="font-display absolute -top-5 -right-4 hidden rounded-2xl border border-[#ff7518]/40 bg-[#1a0e2d] px-4 py-3 text-white shadow-[0_10px_30px_rgba(0,0,0,0.6)] animate-flota md:block lg:-right-6">
          <p class="text-[10px] font-black text-[#ffaa44] tracking-widest uppercase">Incluye</p>
          <p class="text-base font-black">1 Calabaza + 3 Caritas 🐱</p>
        </div>
      </div>
    </section>

    <!-- MARQUESINA HALLOWEEN -->
    <div class="relative z-10 -rotate-1 border-y-2 border-[#ff7518] bg-gradient-to-r from-[#ff7518] via-[#ffa733] to-[#ff5500] py-3 text-[#0d0714] shadow-[0_0_35px_rgba(255,117,24,0.45)]">
      <div class="flex w-max animate-marquee gap-8 pr-8 font-display text-lg font-black whitespace-nowrap uppercase tracking-wider">
        <span>¡truco o caricia! 🎃</span><span>·</span>
        <span>clic clic clic embrujado 👻</span><span>·</span>
        <span>3 caritas intercambiables 🐱</span><span>·</span>
        <span>antiestrés garantizado 😌</span><span>·</span>
        <span>impreso en 3D 🖨️</span><span>·</span>
        <span>edición limitada noche de brujas 🕯️</span><span>·</span>
        <span>regalo perfecto 🎁</span><span>·</span>
        <span>hecho con amor y sustitos 🧡</span><span>·</span>
        <span>¡truco o caricia! 🎃</span><span>·</span>
        <span>clic clic clic embrujado 👻</span><span>·</span>
        <span>3 caritas intercambiables 🐱</span><span>·</span>
        <span>antiestrés garantizado 😌</span><span>·</span>
        <span>impreso en 3D 🖨️</span><span>·</span>
        <span>edición limitada noche de brujas 🕯️</span><span>·</span>
        <span>regalo perfecto 🎁</span><span>·</span>
        <span>hecho con amor y sustitos 🧡</span><span>·</span>
      </div>
    </div>

    <!-- SECCIÓN DE PRODUCTOS: CAJA Y CALABAZA -->
    <section id="manada" class="relative z-10 mx-auto max-w-6xl px-5 py-20 md:px-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-xl">
          <p class="font-display inline-block rounded-full border border-[#ff7518]/40 bg-[#ff7518]/15 px-4 py-1.5 text-sm font-black text-[#ffaa44]">
            LA COLECCIÓN DE HALLOWEEN
          </p>
          <h2 class="font-display text-balance mt-4 text-4xl font-black tracking-tight text-white md:text-6xl">
            Dos clickers mágicos para tu escritorio
          </h2>
        </div>
        <p class="max-w-sm text-sm text-[#ffd9b3]/75 leading-relaxed">
          Presiona la carita del michi o de la calabaza: se sumergen con un clic mecánico y rebotan al instante. Juega con ellos aquí mismo en 3D.
        </p>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-2">
        <!-- Producto 1 : Mishi Calabaza (Nuevo modelo estrella de Halloween) -->
        <article class="arco-gato group relative overflow-hidden border-2 border-[#ff7518]/50 bg-gradient-to-b from-[#1c0f30] via-[#140a22] to-[#0d0714] p-5 pt-7 text-[#fff0db] shadow-[0_25px_70px_rgba(0,0,0,0.8),0_0_35px_rgba(255,117,24,0.2)]">
          <div class="px-3 text-center">
            <span class="inline-block rounded-full bg-[#ff7518] px-4 py-1.5 text-xs font-black tracking-widest text-[#0d0714] shadow-[0_0_15px_rgba(255,117,24,0.6)]">
              ¡NUEVO! EDICIÓN HALLOWEEN 🎃
            </span>
            <h3 class="font-display mt-3 text-3xl sm:text-4xl font-black text-white">Mishi Calabaza 3 en 1</h3>
            <p class="mt-1 min-h-[2.75rem] font-bold text-sm text-[#ffaa44]">
              1 Calabaza + 3 Caritas de gato intercambiables (Pícaro o.<, Travieso >.<, Curioso o.o)
            </p>
          </div>

          <div class="mt-4 overflow-hidden rounded-[26px]">
            <PumpkinClicker alto="h-[360px] md:h-[420px]" />
          </div>

          <div class="flex flex-wrap gap-2 px-2 pt-5">
            <span class="rounded-full border border-[#ff7518]/30 bg-[#24133b] px-3 py-1.5 text-xs font-extrabold text-[#ffd9b3]">
              🎃 1 calabaza + 3 caritas
            </span>
            <span class="rounded-full border border-[#ff7518]/30 bg-[#24133b] px-3 py-1.5 text-xs font-extrabold text-[#ffd9b3]">
              😌 resorte mecánico antiestrés
            </span>
            <span class="rounded-full border border-[#ff7518]/30 bg-[#24133b] px-3 py-1.5 text-xs font-extrabold text-[#ffd9b3]">
              🍬 calcomanías de Halloween
            </span>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-4 px-3 pt-6 pb-2">
            <div>
              <p class="text-xs font-black tracking-widest text-[#ffaa44]">CALABAZA + 3 CARITAS</p>
              <p class="font-display text-4xl font-black text-white">S/ 9</p>
              <p class="text-xs font-bold text-[#ffd9b3]/60">incluye las 3 expresiones</p>
            </div>
            <a
              href="#pedido"
              class="rounded-full bg-gradient-to-r from-[#ff7518] to-[#e65100] px-7 py-3.5 font-display font-black text-[#0d0714] shadow-[0_0_20px_rgba(255,117,24,0.45)] transition hover:scale-105 hover:brightness-110 active:scale-95"
            >
              Pedir Calabaza 🎃
            </a>
          </div>
        </article>

        <!-- Producto 2 : Mishi en su Caja (Clicker Clásico) -->
        <article class="arco-gato group relative overflow-hidden border border-purple-500/30 bg-gradient-to-b from-[#180e2a] via-[#120820] to-[#0d0714] p-5 pt-7 text-[#fff0db] shadow-[0_25px_70px_rgba(0,0,0,0.7)]">
          <div class="px-3 text-center">
            <span class="inline-block rounded-full bg-purple-600/80 px-4 py-1.5 text-xs font-black tracking-widest text-purple-100 shadow-[0_0_15px_rgba(168,85,247,0.4)]">
              CLICKER CLÁSICO 📦
            </span>
            <h3 class="font-display mt-3 text-3xl sm:text-4xl font-black text-white">Mishi en su Caja</h3>
            <p class="mt-1 min-h-[2.75rem] font-bold text-sm text-purple-300">
              Gato + caja con resorte · Clickeas al michi, se sumerge en su caja y salta
            </p>
          </div>

          <div class="mt-4 overflow-hidden rounded-[26px]">
            <GatoClicker cajaSrc="/models/gato1-caja.glb" gatoSrc="/models/gato1-gato.glb" nombre="Mishi en su Caja" alto="h-[360px] md:h-[420px]" />
          </div>

          <div class="flex flex-wrap gap-2 px-2 pt-5">
            <span class="rounded-full border border-purple-500/30 bg-[#221239] px-3 py-1.5 text-xs font-extrabold text-[#ffd9b3]">
              📦 se esconde y salta
            </span>
            <span class="rounded-full border border-purple-500/30 bg-[#221239] px-3 py-1.5 text-xs font-extrabold text-[#ffd9b3]">
              😌 clic satisfactorio
            </span>
            <span class="rounded-full border border-purple-500/30 bg-[#221239] px-3 py-1.5 text-xs font-extrabold text-[#ffd9b3]">
              🎁 calcomanías de regalo
            </span>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-4 px-3 pt-6 pb-2">
            <div>
              <p class="text-xs font-black tracking-widest text-purple-300">CAJA + GATO</p>
              <p class="font-display text-4xl font-black text-white">S/ 7</p>
              <p class="text-xs font-bold text-[#ffd9b3]/60">con calcomanías de regalo</p>
            </div>
            <a
              href="#pedido"
              class="rounded-full bg-purple-600 px-7 py-3.5 font-display font-black text-white shadow-[0_0_20px_rgba(168,85,247,0.4)] transition hover:bg-[#ff7518] hover:text-[#0d0714] hover:scale-105 active:scale-95"
            >
              Pedir Mishi Caja 📦
            </a>
          </div>
        </article>
      </div>
    </section>

    <!-- POR QUÉ NUESTROS MICHIS EN HALLOWEEN -->
    <section class="relative z-10 border-y border-[#ff7518]/20 bg-[#140b22]/70 py-16 backdrop-blur">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 md:grid-cols-[.9fr_1.1fr] md:px-8">
        <div>
          <span class="text-xs font-black tracking-widest text-[#ffaa44] uppercase">Taller Artesanal 3D</span>
          <h2 class="font-display text-balance mt-2 text-4xl font-black text-white md:text-5xl">
            Tallado en 3D, no en una fábrica masiva
          </h2>
          <p class="mt-4 leading-relaxed text-[#ffd9b3]/75">
            Modelamos cada calabaza y carita en 3D con filamento PLA+ premium en colores vibrantes.
            Cada resorte mecánico se calibra a mano para dar un clic adictivo y suave que alivia el estrés en tu escritorio.
          </p>
          <div class="mt-6 flex items-center gap-4 rounded-2xl border border-[#ff7518]/30 bg-[#ff7518]/10 p-4">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-[#ff7518] text-2xl text-[#0d0714]">
              🎃
            </span>
            <p class="text-sm leading-relaxed text-[#ffd9b3]">
              <strong class="text-white">Control pieza por pieza:</strong> bordes suaves, colores firmes y resorte mecánico probado antes de empacar. Si no hace un clic perfecto, no viaja.
            </p>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-3">
          <div class="rounded-3xl border border-[#ff7518]/20 bg-[#180e2a] p-6 shadow-md transition hover:-translate-y-1 hover:border-[#ff7518]/50">
            <div class="text-4xl">😌</div>
            <h3 class="font-display mt-4 text-xl font-black text-white">Antiestrés Real</h3>
            <p class="mt-2 text-xs leading-relaxed text-[#ffd9b3]/70">
              El clic mecánico del michi es súper adictivo para reuniones largas, llamadas y momentos de concentración.
            </p>
          </div>

          <div class="rounded-3xl border border-purple-500/20 bg-[#180e2a] p-6 shadow-md transition hover:-translate-y-1 hover:border-purple-500/50">
            <div class="text-4xl">🐱</div>
            <h3 class="font-display mt-4 text-xl font-black text-white">3 Caritas en 1</h3>
            <p class="mt-2 text-xs leading-relaxed text-[#ffd9b3]/70">
              Cambia la cara del gato calabaza cuando quieras: pícaro, travieso o asombrado según tu estado de ánimo.
            </p>
          </div>

          <div class="rounded-3xl border border-[#2ee6a8]/20 bg-[#180e2a] p-6 shadow-md transition hover:-translate-y-1 hover:border-[#2ee6a8]/50">
            <div class="text-4xl">🎁</div>
            <h3 class="font-display mt-4 text-xl font-black text-white">Listo para Regalar</h3>
            <p class="mt-2 text-xs leading-relaxed text-[#ffd9b3]/70">
              Llega en cajita temática de Halloween con stickers de regalo. ¡El obsequio más original de Noche de Brujas!
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CÓMO FUNCIONA -->
    <section id="como-funciona" class="relative z-10 mx-auto max-w-6xl px-5 py-20 md:px-8">
      <div class="text-center">
        <span class="text-xs font-black tracking-widest text-[#ffaa44] uppercase">Fácil y Rápido</span>
        <h2 class="font-display mt-2 text-4xl font-black text-white md:text-6xl">
          De la calabaza mágica a tu escritorio
        </h2>
        <p class="mx-auto mt-4 max-w-lg text-sm text-[#ffd9b3]/70">Tres pasos y tu michi de Halloween va en camino.</p>
      </div>

      <ol class="mt-12 grid items-start gap-6 md:grid-cols-3">
        <li class="relative overflow-hidden rounded-3xl border border-[#ff7518]/25 bg-[#170c26] p-7 shadow-lg">
          <span class="font-display text-6xl font-black text-[#ff7518]/20">1</span>
          <h3 class="font-display mt-2 text-2xl font-black text-white">Juega en 3D</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#ffd9b3]/70">
            Clickea a la calabaza, cambia sus 3 caritas y gira los modelos 3D para ver cada detalle antes de comprar.
          </p>
          <p class="mt-4 inline-block rounded-full border border-[#ff7518]/30 bg-[#ff7518]/15 px-3 py-1 text-xs font-black text-[#ffaa44]">
            ⏱ Pruébalo gratis
          </p>
        </li>

        <li class="relative overflow-hidden rounded-3xl border border-purple-500/25 bg-[#170c26] p-7 shadow-lg">
          <span class="font-display text-6xl font-black text-purple-500/20">2</span>
          <h3 class="font-display mt-2 text-2xl font-black text-white">Elige tu Michi</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#ffd9b3]/70">
            Elige el Mishi Calabaza (con sus 3 caritas), el Mishi en su Caja clásico o el Combo Embrujado para coleccionar ambos.
          </p>
