<script>
  // Resaltado dinámico de la tarjeta seleccionada
  const radioCards = document.querySelectorAll("[data-radio-card]");
  function actualizarResaltado() {
    radioCards.forEach((card) => {
      const radio = card.querySelector('input[type="radio"]') as HTMLInputElement | null;
      if (radio && radio.checked) {
        card.classList.add("border-[#ff7518]", "bg-[#ff7518]/20", "shadow-[0_0_20px_rgba(255,117,24,0.3)]");
        card.classList.remove("border-white/10", "bg-[#150a24]/60");
      } else {
        card.classList.remove("border-[#ff7518]", "bg-[#ff7518]/20", "shadow-[0_0_20px_rgba(255,117,24,0.3)]");
        card.classList.add("border-white/10", "bg-[#150a24]/60");
      }
    });
  }

  document.querySelectorAll('input[name="michi"]').forEach((r) => {
    r.addEventListener("change", actualizarResaltado);
  });
  actualizarResaltado();

  // Enlace interactivo con WhatsApp API
  const form = document.getElementById("form-halloween") as HTMLFormElement | null;
  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const seleccion = (fd.get("michi") as string) || "calabaza";

      let mensaje = "";
      if (seleccion === "calabaza") {
        mensaje = "¡Hola! 🎃 Me interesa pedir el Mishi Calabaza (1 calabaza + 3 caritas intercambiables) por S/ 9. ¿Tienen disponible?";
      } else if (seleccion === "caja") {
        mensaje = "¡Hola! 📦 Me interesa pedir el Mishi en su Caja Clicker por S/ 7. ¿Tienen disponible?";
      } else if (seleccion === "combo") {
        mensaje = "¡Hola! ✨ Me interesa pedir el Combo Dúo Embrujado (Mishi Calabaza con 3 caritas + Mishi en su Caja) por S/ 15. ¿Tienen disponible?";
      } else {
        mensaje = "¡Hola! 🎃 Me interesa pedir un michi de Halloween. ¿Tienen disponible?";
      }

      const url = `https://api.whatsapp.com/send?phone=51933468699&text=${encodeURIComponent(mensaje)}`;
      window.open(url, "_blank");
    });
  }
</script>
